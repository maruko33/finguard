# Local development only; never use the AWS RDS password here.
# Set this to the existing local database password; changing it does not reset a volume.
# Single-quote literal values, especially passwords containing $, #, spaces or backslashes.
POSTGRES_PASSWORD=''
# Compose and scripts/mvn-local.py map POSTGRES_PASSWORD to the API's DB_PASSWORD.
# Do not source this file or load it with xargs; see services/transaction-api/README.md.
SQS_QUEUE_URL=https://sqs.ca-central-1.amazonaws.com/<account-id>/finguard-transactions
